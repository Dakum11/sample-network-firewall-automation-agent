# =============================================================================
# AWS Network Firewall Automation Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before deploying.
# All variables marked [REQUIRED] must be set for the agent to function.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# [REQUIRED] AWS region for all services
AWS_REGION=us-east-1

# AWS CLI profile name (for local development)
AWS_PROFILE=default

# -----------------------------------------------------------------------------
# Bedrock AgentCore Configuration
# -----------------------------------------------------------------------------
# [OPTIONAL] AgentCore Memory ID for conversation persistence (agent works without it)
AGENTCORE_MEMORY_ID=your-memory-id-here

# [REQUIRED] Bedrock model ID for the supervisor agent
# Use an inference profile ID (e.g., us.anthropic.claude-sonnet-4-20250514-v1:0)
# NOT the raw model ID (anthropic.claude-sonnet-4-...) — on-demand requires inference profiles
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# [REQUIRED] AgentCore Runtime ID (created during initial deployment)
AGENT_RUNTIME_ID=your-agent-runtime-id

# Runtime name for AgentCore (only used during --create; alphanumeric + underscores only, no hyphens)
AGENT_RUNTIME_NAME=firewall_automation_agent

# -----------------------------------------------------------------------------
# Azure DevOps Configuration (for GitOps Agent — Optional)
# -----------------------------------------------------------------------------
# Azure DevOps organization name (required only for GitSecOps functionality)
AZURE_DEVOPS_ORG=your-org-name

# Azure DevOps project name
AZURE_DEVOPS_PROJECT=your-project-name

# Git repository name containing firewall rules
REPO_NAME=your-firewall-rules-repo

# Name of the Secrets Manager secret containing Azure DevOps PAT
# Secret format: {"username": "...", "password": "<PAT_TOKEN>"}
AZURE_DEVOPS_SECRET_NAME=firewall-automation/azure-devops/pat

# -----------------------------------------------------------------------------
# Account Details Configuration (DynamoDB)
# -----------------------------------------------------------------------------
# IAM role ARN for cross-account DynamoDB access (leave empty if same account)
CROSS_ACCOUNT_ROLE_ARN=arn:aws:iam::123456789012:role/AccountDetailsReadRole

# DynamoDB table name suffix for deployment state
DYNAMODB_DEPLOYMENT_STATE_TABLE_SUFFIX=-deployment-state

# DynamoDB table name for account metadata
DYNAMODB_ACCOUNT_METADATA_TABLE_NAME=account-metadata

# -----------------------------------------------------------------------------
# IPAM Configuration
# -----------------------------------------------------------------------------
# Secrets Manager secret name for IPAM credentials
# Secret format: {"username": "...", "password": "...", "ipam_url": "https://..."}
IPAM_SECRET_NAME=ipam/credentials
# TLS verification for IPAM calls (secure by default).
# Set IPAM_CA_BUNDLE to a CA bundle path for an internal CA, or
# IPAM_VERIFY_TLS=false to disable verification (NOT recommended; isolated labs only).
# IPAM_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
# IPAM_VERIFY_TLS=true

# -----------------------------------------------------------------------------
# ServiceNow Configuration (Optional - ServiceNow Agent)
# -----------------------------------------------------------------------------
# ServiceNow instance URL, e.g. https://<instance>.service-now.com
# SERVICENOW_INSTANCE=
# Secrets Manager secret with ServiceNow creds: {"username": "...", "password": "..."}
# (falls back to SERVICENOW_USERNAME / SERVICENOW_PASSWORD env vars if the secret is absent)
# SERVICENOW_SECRET_NAME=servicenow/credentials

# -----------------------------------------------------------------------------
# Firewall Logs Configuration (Optional - OpenSearch)
# -----------------------------------------------------------------------------
# OpenSearch (Serverless) endpoint for firewall log queries
# OPENSEARCH_ENDPOINT=https://<collection-id>.<region>.aoss.amazonaws.com
# Optional cross-account role to assume for OpenSearch access (else uses execution role)
# OPENSEARCH_ROLE_ARN=

# -----------------------------------------------------------------------------
# Deployment Configuration
# -----------------------------------------------------------------------------
# AWS account ID (auto-detected from AWS CLI if not set)
# AWS_ACCOUNT_ID=123456789012

# ECR repository name (default: firewall-automation-agent)
ECR_REPOSITORY_NAME=firewall-automation-agent

# [REQUIRED] Comma-separated subnet IDs for AgentCore VPC configuration
AGENT_SUBNETS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy

# [REQUIRED] Comma-separated security group IDs for AgentCore
AGENT_SECURITY_GROUPS=sg-xxxxxxxxxxxxxxxxx

# IAM execution role name for AgentCore (default: FirewallAutomation-AgentCore-Execution-Role)
AGENT_EXECUTION_ROLE_NAME=FirewallAutomation-AgentCore-Execution-Role

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Bypass tool consent prompts (set to true for automated deployments)
BYPASS_TOOL_CONSENT=true

# Disable editor backup files
EDITOR_DISABLE_BACKUP=true

# Verbose logging for git operations
VERBOSE=true
